<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>NKaspa</RootNamespace>
    <AssemblyName>NKaspa</AssemblyName>
    <Version>0.1.10-alpha</Version>
    <PackageId>NKaspa</PackageId>
    <Authors>lifeme2027</Authors>
    <Title>NKaspa</Title>
    <Description>A .NET library for Kaspa. The public API follows NBitcoin where a Kaspa counterpart exists. This alpha covers addresses, keys, scripts, transactions, BIP39, BIP32, PSKT, fees, and a minimal wRPC client.</Description>
    <PackageTags>kaspa;blockchain;crypto;nbitcoin</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/lifeme2027/NKaspa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lifeme2027/NKaspa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBitcoin.Secp256k1" Version="3.1.6" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NKaspa.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BIP39\english.txt">
      <LogicalName>NKaspa.BIP39.english.txt</LogicalName>
    </EmbeddedResource>
    <None Include="BIP39\WORDLIST-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
