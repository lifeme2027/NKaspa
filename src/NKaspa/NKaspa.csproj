<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <RootNamespace>NKaspa</RootNamespace>
    <AssemblyName>NKaspa</AssemblyName>
    <Version>0.1.7-alpha</Version>
    <PackageId>NKaspa</PackageId>
    <Title>NKaspa</Title>
    <Description>A .NET library for Kaspa, structured as a counterpart of NBitcoin. Alpha: keys, Schnorr and ECDSA signatures, scripts, version-0 and Toccata version-1 transactions, BLAKE2b and BLAKE3, sighash, BIP39, BIP32, a transaction builder with must-spend coin selection and version-1 payments, PSKT (partially signed Kaspa transactions) aligned with rusty-kaspa wallet/pskt, mass and fees, a minimal wRPC JSON client, System.Text.Json converters, encoders, uint256, networks, and addresses. The script engine executes version-0 scripts, including pay-to-script-hash. OP_ZKPRECOMPILE enforces the finalized structural checks and leaves the BN254 pairing and the RISC0 STARK unimplemented. Newtonsoft.Json is not a dependency.</Description>
    <PackageTags>kaspa;nkaspa;blockchain</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/lifeme2027/NKaspa</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NBitcoin.Secp256k1" Version="3.1.6" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NKaspa.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="BIP39\english.txt">
      <LogicalName>NKaspa.BIP39.english.txt</LogicalName>
    </EmbeddedResource>
    <None Include="BIP39\WORDLIST-LICENSE.txt" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\NOTICE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
